# ---- Shopify ----
SHOPIFY_SHOP=your-store.myshopify.com
# Dev Dashboard app (created 2026 or later): client ID + secret
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# OR an older custom app's Admin API token (leave the two above empty)
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07

# ---- Safety ----
# Keep true until you have reviewed data/actions.csv
DRY_RUN=true

# ---- Matching ----
DEFAULT_COUNTRY_CALLING_CODE=91
MIN_ORDER_AGE_MINUTES=10
LOOKBACK_HOURS=48
NEW_CUSTOMER_WINDOW_HOURS=24
POLL_INTERVAL_MINUTES=5

# ---- Points transfer (stage 2) ----
POINTS_DELAY_AFTER_DELIVERY_MINUTES=60
POINTS_MAX_WAIT_DAYS=30

# ---- Flits ----
FLITS_ENABLED=true
# Paste the keys Flits gave you here. Never put them in the code or commit .env.
FLITS_READ_API_KEY=
FLITS_ADD_API_KEY=
FLITS_ADD_POINTS_ACTION_ID=Ns3x94kSXoZvgqDLLW11Kw
FLITS_INTEGRATION_APP_NAME=flits-kwikpass
FLITS_MOVE_POINTS_TO_OLD_CUSTOMER=true

# ---- Dashboard ----
# On Railway: don't set DASHBOARD_HOST / DASHBOARD_PORT / DATA_DIR; Railway provides PORT and the Volume path.
# One login per team member: name:password, comma separated. Names appear in the merge history.
DASHBOARD_USERS=
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3000
